#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (-14.849799343759075, 0.25871150161519674, -6.074544242263212)
                double3 target = (-6.211217281308102, 0.86812569328039, -6.015262767101254)
            }
            dictionary Right = {
                double3 position = (-5, 0, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 5, 0)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./parking_environment_v2.usd"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    doc = """Underground parking environment v2.
Interior 26.0 x 19.0 m, clear height 5.6 m.
Two west-wall gates (inbound Z=-5.5 / outbound Z=5.5, 4.5 m clear width),
two vehicle handoff wait bays, two robot wait/charge docks, three parking slots A1/A2/A3, two ceiling RTX lidars, 14 ArUco markers (DICT_5X5_100).
Vehicles are NOT included - reference fab_vehicles.usd separately."""
    metersPerUnit = 1
    timeCodesPerSecond = 60
    upAxis = "Y"
)

def Xform "World" (
    customData = {
        string activeParkingSpaces = "A1, A2, A3"
        string arucoDictionary = "DICT_5X5_100"
        int arucoMarkerCount = 14
        string basedOn = "parking_environment_with_markers.usd"
        string ceilingLidarConfig = "SICK_multiScan136"
        int ceilingLidarCount = 2
        double clearHeightM = 5.6
        double gateClearWidthM = 4.5
        int gateCount = 2
        string generator = "build_parking_environment_v2.py"
        double interiorDepthM = 19
        double interiorWidthM = 26
        double parkingSpaceLengthM = 6.6
        double parkingSpaceWidthM = 3.4
        int robotDockCount = 2
        int vehicleWaitBayCount = 2
    }
)
{
    def PhysicsScene "PhysicsScene" (
        apiSchemas = ["PhysxSceneAPI", "PhysxVehicleContextAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, -1, 0)
        float physics:gravityMagnitude = 9.81
        uniform token physxVehicleContext:longitudinalAxis = "posZ"
        uniform token physxVehicleContext:updateMode = "velocityChange"
        uniform token physxVehicleContext:verticalAxis = "posY"
    }

    def Scope "VehiclePhysics"
    {
        def Material "TarmacMaterial" (
            apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.9
            float physics:restitution = 0.02
            float physics:staticFriction = 1.05
        }

        def PhysxVehicleTireFrictionTable "RoadTireFriction"
        {
            custom float[] frictionValues = [1.05]
            custom rel groundMaterials = </World/VehiclePhysics/TarmacMaterial>
        }

        def PhysicsCollisionGroup "ChassisGroup"
        {
            rel physics:filteredGroups = </World/VehiclePhysics/GroundQueryGroup>
        }

        def PhysicsCollisionGroup "WheelGroup"
        {
            rel physics:filteredGroups = [
                </World/VehiclePhysics/GroundQueryGroup>,
                </World/VehiclePhysics/GroundGroup>,
            ]
        }

        def PhysicsCollisionGroup "GroundQueryGroup"
        {
            rel physics:filteredGroups = [
                </World/VehiclePhysics/ChassisGroup>,
                </World/VehiclePhysics/WheelGroup>,
            ]
        }

        def PhysicsCollisionGroup "GroundGroup"
        {
            rel collection:colliders:includes = [
                </World/ParkingEnvironment/Floor>,
                </World/ParkingEnvironment/ExternalAprons/EntryApron/Floor>,
                </World/ParkingEnvironment/ExternalAprons/ExitApron/Floor>,
            ]
            rel physics:filteredGroups = [
                </World/VehiclePhysics/GroundGroup>,
                </World/VehiclePhysics/WheelGroup>,
            ]
        }
    }

    def Scope "Looks"
    {
        def Material "Asphalt"
        {
            token outputs:surface.connect = </World/Looks/Asphalt/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.115, 0.125, 0.14)
                float inputs:metallic = 0
                float inputs:roughness = 0.92
                token outputs:surface
            }
        }

