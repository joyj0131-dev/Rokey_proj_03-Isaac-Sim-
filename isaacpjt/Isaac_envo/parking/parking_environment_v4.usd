        def Material "ArucoMat_040"
        {
            token outputs:surface.connect = </World/Looks/ArucoMat_040/Shader.outputs:surface>

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./../textures/aruco/aruco_DICT_5X5_100_040.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/ArucoMat_040/StReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }

            def Shader "Shader"
