Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.08
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 58; 60; 65
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Parking Grid
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.7
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree: {}
      Update Interval: 0
      Value: false
    - Alpha: 0.14
      Class: rviz_default_plugins/PointCloud2
      Color: 135; 138; 142
      Color Transformer: FlatColor
      Decay Time: 1
      Enabled: false
      Name: LiDAR Raw
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /parking/lidar/points_world
      Use Fixed Frame: true
      Value: false
    - Alpha: 0.80
      Class: rviz_default_plugins/PointCloud2
      Color: 120; 220; 255
      Color Transformer: FlatColor
      Decay Time: 1
      Enabled: true
      Name: LiDAR Height Filtered
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.035
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /parking/lidar/points_filtered
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 135; 105
      Color Transformer: FlatColor
      Decay Time: 1
      Enabled: true
      Name: LiDAR Points In Slots
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 5
      Size (m): 0.055
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /parking/lidar/points_in_slots
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Slot Occupancy
      Namespaces:
        analysis_info: true
        blocked_zones: true
        info_panel: true
        lidar_sensor: true
        monitor_title: true
        occupancy_summary: true
        sensor_metrics: true
        sensor_status: true
        sensor_topic: true
        status_panel: true
        slot_boundary: true
        slot_count: true
        slot_fill: true
        slot_name: true
        slot_state: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /parking/slot_markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 18; 19; 22
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Name: Slot Occupancy Demo
      Scale: 13
      Target Frame: <Fixed Frame>
      X: 5.4
      Y: 0
      Value: TopDownOrtho (rviz)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  X: 40
  Y: 30
